<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="PlaywrightCertSuite" verbose="1" parallel="tests" thread-count="5">
    <listeners>
        <listener class-name="com.certification.base.SummaryListener"/>
    </listeners>

    <test name="ChromiumTests">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.certification.tests.PlaywrightSiteTest"/>
        </classes>
    </test>
    <test name="FirefoxTests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.certification.tests.PlaywrightSiteTest"/>
        </classes>
    </test>
    <test name="EdgeTests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.certification.tests.PlaywrightSiteTest"/>
        </classes>
    </test>

    <test name="WindowsChromium">
        <parameter name="browser" value="pw-chromium"/>
        <parameter name="platform" value="Windows 10"/>
        <classes>
            <class name="com.certification.tests.PlaywrightSiteTest"/>
        </classes>
    </test>
    <test name="MacSonomaFirefox">
        <parameter name="browser" value="pw-firefox"/>
        <parameter name="platform" value="MacOS Sonoma"/>
        <classes>
            <class name="com.certification.tests.PlaywrightSiteTest"/>
        </classes>
    </test>
</suite>
